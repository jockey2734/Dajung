# Public host for Caddy. Use a hostname only, without https://.
# Caddy 공개 호스트. https:// 없이 호스트명만 쓴다.
PUBLIC_HOST=dajung.example.duckdns.org

# Duck DNS updater inputs. Used by host-side timer/scripts, not committed with real values.
# Duck DNS 갱신 입력값. 실제 값은 커밋하지 않고 호스트 timer/scripts에서 사용한다.
DUCKDNS_DOMAIN=dajung-example
DUCKDNS_TOKEN=change-me

# Compose database bootstrap. Replace before any real deployment.
# Compose DB 초기화값. 실 배포 전 반드시 교체한다.
DAJUNG_POSTGRES_DB=dajung
DAJUNG_POSTGRES_USER=dajung
DAJUNG_POSTGRES_PASSWORD=change-me

# Dajung API secrets. Generate with: openssl rand -hex 32
# Dajung API 시크릿. 생성: openssl rand -hex 32
DAJUNG_JWT_SECRET=change-me
DAJUNG_ANTHROPIC_API_KEY=

# Exchange-rate lookup (ADR-028 / webapp-spec S30). Issued by 한국수출입은행 오픈API.
# 환율 조회 (ADR-028 / webapp-spec S30). 한국수출입은행 오픈API에서 발급받는다.
# Daily cap 1,000 calls per key; the key is destroyed when the 2-year personal-info
# retention period lapses, which surfaces as an auth error.
# 키당 일 1,000회 한도. 개인정보 보유기간 2년 만료 시 키가 폐기되며 인증 오류로 나타난다.
DAJUNG_KOREAEXIM_API_KEY=

# Dajung API runtime. Compose builds DAJUNG_DATABASE_URL from the DB fields above.
# Dajung API 런타임. Compose에서는 위 DB 필드로 DAJUNG_DATABASE_URL을 만든다.
DAJUNG_DATABASE_URL=
DAJUNG_QDRANT_URL=http://qdrant:6333
DAJUNG_QDRANT_API_KEY=
DAJUNG_OLLAMA_BASE_URL=http://ollama:11434
DAJUNG_COLLECTION=dajung
DAJUNG_UPLOAD_DIR=data/uploads
DAJUNG_MODEL_HAIKU=claude-haiku-4-5
DAJUNG_MODEL_SONNET=claude-sonnet-5
DAJUNG_MODEL_OPUS=claude-opus-5
DAJUNG_ROUTER_MODEL=gemma4:e4b
DAJUNG_DAILY_CHAT_LIMIT=20
DAJUNG_SSE_CHUNK_CHARS=60
DAJUNG_HEALTH_PROBE_TIMEOUT_S=2.0
DAJUNG_UPLOAD_MAX_FILE_BYTES=20971520
DAJUNG_UPLOAD_MAX_FILES=5
DAJUNG_ATTACHMENT_MAX_CHARS=12000
DAJUNG_HISTORY_MAX_MESSAGES=10
DAJUNG_HISTORY_MESSAGE_MAX_CHARS=500
DAJUNG_HISTORY_TOTAL_MAX_CHARS=4000
DAJUNG_WEB_SEARCH_MAX_USES=3
DAJUNG_MEMORY_INPUT_CHARS=30000
DAJUNG_MEMORY_OUTPUT_CHARS=1000
DAJUNG_MAX_TOKENS_MEMORY=1000
DAJUNG_RETRIEVE_LIMIT=20
DAJUNG_RERANK_TOP_K=5
DAJUNG_RERANK_THRESHOLD=0.5
DAJUNG_MAX_RETRIES=2

# Auth.js / BFF. Generate AUTH_SECRET with: pnpm dlx auth secret
# Auth.js / BFF. AUTH_SECRET 생성: pnpm dlx auth secret
AUTH_SECRET=change-me
API_BASE_URL=http://api:8000
