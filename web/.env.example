# FastAPI base URL, reachable only from the BFF (server-side) — never sent to the browser.
# BFF(서버 사이드)에서만 접근하는 FastAPI 기본 URL — 브라우저로 전송되지 않는다.
API_BASE_URL=http://api:8000

# Auth.js JWT/session encryption secret. Generate with: pnpm dlx auth secret
# Auth.js JWT/세션 암호화 시크릿. 생성: pnpm dlx auth secret
AUTH_SECRET=

# Trust reverse-proxy host headers from Caddy.
# Caddy의 reverse-proxy host header를 신뢰한다.
AUTH_TRUST_HOST=true
